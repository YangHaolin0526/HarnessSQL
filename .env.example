# Hosted OpenAI-compatible endpoint used by data generation or dsh-sql.
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://example.invalid/v1
OPENAI_MODEL=your-model

# Optional Anthropic-compatible endpoint.
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_BASE_URL=https://example.invalid
ANTHROPIC_MODEL=your-model

# dsh-sql model routes. Local vLLM accepts any non-empty placeholder key.
VLLM_API_KEY=local-vllm
DSH_SQL_VLLM_BASE_URL=http://127.0.0.1:8000/v1
DSH_SQL_VLLM_MODEL=your-local-model
DSH_SQL_GATEWAY_KEY=replace-me
DSH_SQL_GATEWAY_BASE_URL=https://example.invalid/v1
DSH_SQL_GATEWAY_MODEL=your-hosted-model

# RL data roots. All paths must be supplied by the user; there are no host defaults.
HARNESS_SQL_SYNTH_ROOT=/path/to/spider2/synthesized
HARNESS_SQL_SPIDER_DB_DIR=/path/to/spider2/sqlite/databases
HARNESS_SQL_DBT_SYNTH_ROOT=/path/to/dbt/synthesized
HARNESS_SQL_DBT_DB_DIR=/path/to/dbt/sqlite/databases
HARNESS_SQL_KTX_BIN=/path/to/ktx/dist/bin.js
HARNESS_SQL_KTX_PROJECT=/path/to/ktx/project
