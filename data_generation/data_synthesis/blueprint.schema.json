{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/spider2-sqlite-blueprint.schema.json",
  "title": "Spider 2.0 SQLite synthesis blueprint",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "sample_id",
    "database_id",
    "template_id",
    "instruction",
    "sql",
    "expected_columns",
    "row_bounds",
    "operators",
    "roles",
    "joins",
    "mutations"
  ],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1},
    "database_id": {"type": "string", "minLength": 1},
    "difficulty_band": {
      "enum": ["foundation", "core", "growth", "stretch"],
      "description": "Bounded generation band; required for newly model-generated candidates."
    },
    "template_id": {"type": "string", "minLength": 1},
    "instruction": {"type": "string", "minLength": 20},
    "sql": {"type": "string", "pattern": "^\\s*(SELECT|WITH)\\b"},
    "expected_columns": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "row_bounds": {
      "type": "array",
      "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}],
      "minItems": 2,
      "maxItems": 2
    },
    "operators": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "kind", "query", "selected"],
        "properties": {
          "role": {"type": "string"},
          "kind": {"enum": ["table", "column"]},
          "query": {"type": "string"},
          "selected": {"type": "string"},
          "table": {"type": "string"},
          "type": {"enum": ["numeric", "text", "temporal", "blob", "unknown"]}
        }
      }
    },
    "joins": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "string"},
          {"type": "string"},
          {"type": "string"},
          {"type": "string"}
        ],
        "minItems": 4,
        "maxItems": 4
      }
    },
    "mutations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "old", "new"],
        "properties": {
          "id": {"type": "string"},
          "category": {"type": "string"},
          "old": {"type": "string", "minLength": 1},
          "new": {"type": "string"}
        }
      }
    }
  }
}
